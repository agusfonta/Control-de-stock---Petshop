{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc"],
  "globals": {
    "document": "readonly",
    "window": "readonly",
    "fetch": "readonly",
    "localStorage": "readonly",
    "URLSearchParams": "readonly",
    "Event": "readonly",
    "setTimeout": "readonly",
    "confirm": "readonly",
    "alert": "readonly"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "no-undef": "error",
    "no-unused-vars": "warn",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  }
}
